{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Star",
  "version": "1.0.3",
  "identifier": "com.star.desktop",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix frontend run dev",
    "beforeBuildCommand": "npm --prefix frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Star Studio & Queue Dashboard",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../src/**/*",
      "../package.json"
    ],
    "externalBin": [
      "binaries/star-engine"
    ]
  },
  "plugins": {
    "shell": {
      "sidecar": true
    }
  }
}